# ==============================================================================
# LiveMap Node.js Backend Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Server HTTP Port & Host
PORT=8001
HOST=0.0.0.0

# Frontend URL (allowed CORS origin & redirect base)
FRONTEND_URL=http://localhost:5173

# MongoDB Connection Configuration
# MONGODB_URI: Connection URI string (takes precedence over MONGO_URL)
MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB: Target database name (takes precedence over DB_NAME)
MONGODB_DB=spacer_land

# Backward Compatibility Mongo Variables
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=spacer_land

# JWT & Authentication Configuration
# JWT_SECRET: Secret key for signing access tokens. MUST be changed in production!
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# JWT_EXPIRES_IN: Token expiration duration (e.g., 7d, 24h, 86400s)
JWT_EXPIRES_IN=7d
TOKEN_TTL_SECONDS=86400
# JWT_COOKIE_NAME: Name of the HttpOnly auth cookie expected by the frontend
JWT_COOKIE_NAME=access_token

# Cookie Security Settings
# COOKIE_SECURE: Set to true in production (requires HTTPS)
COOKIE_SECURE=false
# COOKIE_SAME_SITE: Cookie SameSite policy (lax | strict | none)
COOKIE_SAME_SITE=lax
COOKIE_SAMESITE=lax

# Storage Configuration
# STORAGE_DRIVER: Storage provider (local | s3 | r2)
# For Cloudflare R2, set STORAGE_DRIVER=s3 (R2 uses S3-compatible API)
STORAGE_DRIVER=local
# LOCAL_STORAGE_PATH: Storage directory relative to backend-node root
LOCAL_STORAGE_PATH=./storage
STORAGE_DIR=./storage
# MAX_UPLOAD_SIZE_MB: Maximum upload file size limit in megabytes
MAX_UPLOAD_SIZE_MB=50

# S3 / Cloudflare R2 Configuration (applicable if STORAGE_DRIVER=s3 or r2)
# R2 Endpoint format: https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=livemap-storage
S3_REGION=auto
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GIS & Map Service Configuration
# OVERPASS_API_URL: OpenStreetMap Overpass API endpoint for entrance road detection
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Python GIS Worker Service Configuration
ENABLE_PYTHON_GIS_FALLBACK=true
PYTHON_GIS_URL=http://127.0.0.1:8000
# Must match INTERNAL_GIS_SECRET in backend/python/.env. Replace this dev-only value in production.
INTERNAL_GIS_SECRET=dev-internal-secret-key-change-in-prod


# Seed Super Admin & Admin Credentials
SUPER_ADMIN_EMAIL=superadmin@livemap.local
SUPER_ADMIN_PASSWORD=SuperAdmin@2026
ADMIN_EMAIL=admin@livemap.local
ADMIN_PASSWORD=Admin@2026

# Static Frontend Serving Configuration (Single-process deployment)
SERVE_FRONTEND=true
FRONTEND_DIST=../frontend/dist
