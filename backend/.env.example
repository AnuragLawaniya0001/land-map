# ==============================================================================
# LiveMap Python API Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Main API server (the React/Vite proxy defaults to port 4801).
PORT=4801
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:4800
SERVE_FRONTEND=true
# Optional path; defaults to the project's frontend/dist directory.
# FRONTEND_DIST=../../frontend/dist

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=spacer_land

# Authentication. Use the same JWT_SECRET as the previous API to keep existing
# login sessions valid until expiry; generate a new 32+ character secret for production.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
TOKEN_TTL_SECONDS=86400
JWT_COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Local storage defaults to backend/node/storage to keep existing uploaded files
# available during migration. Set STORAGE_DRIVER=emergent to use object storage.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=node/storage

# Legacy protected GIS endpoint setting. Replace before exposing this endpoint.
INTERNAL_GIS_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET

# Optional DWG conversion via ODA File Converter.
# Install ODA File Converter on this worker before enabling DWG uploads.
# Windows example:
# ODA_FILE_CONVERTER=C:\Program Files\ODA\ODAFileConverter\ODAFileConverter.exe
# Linux/macOS example: absolute path to the ODAFileConverter executable.
ODA_FILE_CONVERTER=

# Backward-compatible aliases for older scripts.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=spacer_land
