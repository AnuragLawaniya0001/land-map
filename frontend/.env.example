# ==============================================================================
# LiveMap Frontend Environment Configuration (.env.example)
# ==============================================================================

# VITE_API_BASE_URL: Base API path for requests.
# Defaults to /api so Vite proxying or same-origin deployment works cleanly.
VITE_API_BASE_URL=/api

# VITE_BACKEND_URL: Optional explicit backend origin URL (e.g., http://localhost:8001).
# Leave empty when using Vite dev server proxy or same-origin production deployment.
VITE_BACKEND_URL=
