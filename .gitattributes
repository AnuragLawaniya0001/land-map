# Set default behavior to automatically handle line endings
* text=auto eol=lf

# Explicitly ensure Linux line endings (LF) for scripts, configs, and code
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
